{
    "name": "@timecat-js/recorder",
    "version": "0.0.0",
    "description": "TimeCat session recorder: time-sliced DOM snapshots, per-frame mutations, input, pointer and scroll, encoded and compressed off the main thread",
    "keywords": [
        "recording",
        "rrweb",
        "session-replay",
        "timecat"
    ],
    "homepage": "https://github.com/h5box/TimeCat/tree/master/packages/recorder#readme",
    "bugs": "https://github.com/h5box/TimeCat/issues",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/h5box/TimeCat.git",
        "directory": "packages/recorder"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "@timecat-js/source": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./worker": {
            "types": "./dist/worker.d.ts",
            "default": "./dist/worker.js"
        }
    },
    "publishConfig": {
        "exports": {
            ".": "./dist/index.js",
            "./package.json": "./package.json",
            "./worker": {
                "types": "./dist/worker.d.ts",
                "default": "./dist/worker.js"
            }
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc -p .",
        "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
    },
    "dependencies": {
        "@timecat-js/protocol": "workspace:^"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "catalog:",
        "fast-check": "catalog:",
        "publint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
