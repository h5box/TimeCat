{
    "name": "@timecat-js/plugin-network",
    "version": "0.0.0",
    "description": "TimeCat recorder plugin: requests made by fetch, XMLHttpRequest and sendBeacon, and the resources a page loads",
    "keywords": [
        "fetch",
        "network",
        "session-replay",
        "timecat"
    ],
    "homepage": "https://github.com/h5box/TimeCat/tree/master/packages/plugin-network#readme",
    "bugs": "https://github.com/h5box/TimeCat/issues",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/h5box/TimeCat.git",
        "directory": "packages/plugin-network"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "@timecat-js/source": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "exports": {
            ".": "./dist/index.js",
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc -p .",
        "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
    },
    "dependencies": {
        "@timecat-js/protocol": "workspace:^"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "catalog:",
        "@timecat-js/recorder": "workspace:^",
        "publint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@timecat-js/recorder": "workspace:^"
    }
}
