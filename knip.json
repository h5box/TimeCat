{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": ["*.config.ts"]
        },
        "packages/*": {
            "project": ["src/**/*.ts", "test/**/*.ts"]
        },
        "apps/extension": {
            "entry": ["src/{background,bridge,main,popup,recordings,player}.ts"],
            "project": ["*.ts", "src/**/*.ts", "test/**/*.ts"]
        },
        "apps/bench": {
            "entry": ["src/page/*.ts"],
            "project": ["src/**/*.ts"]
        }
    },
    "ignore": ["rfcs/**"]
}
