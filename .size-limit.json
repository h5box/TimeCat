[
    {
        "name": "@timecat-js/protocol (everything)",
        "path": "packages/protocol/dist/index.js",
        "import": "*",
        "gzip": true,
        "limit": "7 kB"
    },
    {
        "name": "@timecat-js/recorder (main thread)",
        "path": "packages/recorder/dist/index.js",
        "import": "{ record }",
        "gzip": true,
        "limit": "15 kB"
    },
    {
        "name": "@timecat-js/player-core (lazy chunks and worker included)",
        "path": "packages/player-core/dist/index.js",
        "import": "{ createPlayer }",
        "gzip": true,
        "limit": "22 kB"
    }
]
