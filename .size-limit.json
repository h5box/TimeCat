[
    {
        "name": "@timecat-js/protocol (everything)",
        "path": "packages/protocol/dist/index.js",
        "import": "*",
        "gzip": true,
        "limit": "8 kB"
    },
    {
        "name": "@timecat-js/recorder (loaded with the page)",
        "path": "packages/recorder/dist/index.js",
        "import": "{ record }",
        "entry": ["index"],
        "gzip": true,
        "limit": "15.5 kB"
    },
    {
        "name": "@timecat-js/recorder (worker and main-thread fallback, loaded on demand, included)",
        "path": "packages/recorder/dist/index.js",
        "import": "{ record }",
        "gzip": true,
        "limit": "21.5 kB"
    },
    {
        "name": "@timecat-js/player-core (loaded with the page)",
        "path": "packages/player-core/dist/index.js",
        "import": "{ createPlayer }",
        "entry": ["index"],
        "gzip": true,
        "limit": "17.5 kB"
    },
    {
        "name": "@timecat-js/player-core (lazy chunks and worker included)",
        "path": "packages/player-core/dist/index.js",
        "import": "{ createPlayer }",
        "gzip": true,
        "limit": "41.5 kB"
    },
    {
        "name": "@timecat-js/plugin-console",
        "path": "packages/plugin-console/dist/index.js",
        "import": "{ consolePlugin }",
        "gzip": true,
        "limit": "3 kB"
    },
    {
        "name": "@timecat-js/plugin-network",
        "path": "packages/plugin-network/dist/index.js",
        "import": "{ networkPlugin }",
        "gzip": true,
        "limit": "2 kB"
    },
    {
        "name": "@timecat-js/plugin-perf",
        "path": "packages/plugin-perf/dist/index.js",
        "import": "{ perfPlugin }",
        "gzip": true,
        "limit": "2 kB"
    },
    {
        "name": "@timecat-js/plugin-canvas",
        "path": "packages/plugin-canvas/dist/index.js",
        "import": "{ canvasPlugin }",
        "ignore": ["@timecat-js/recorder"],
        "gzip": true,
        "limit": "3.5 kB"
    },
    {
        "name": "@timecat-js/plugin-media",
        "path": "packages/plugin-media/dist/index.js",
        "import": "{ mediaPlugin }",
        "ignore": ["@timecat-js/recorder"],
        "gzip": true,
        "limit": "2.5 kB"
    },
    {
        "name": "@timecat-js/player (the element with Lit, player-core aside)",
        "path": "packages/player/dist/index.js",
        "import": "{ TimecatPlayer }",
        "ignore": ["@timecat-js/player-core", "@timecat-js/protocol"],
        "gzip": true,
        "limit": "14.5 kB"
    },
    {
        "name": "@timecat-js/player/standalone (one script with all it needs)",
        "path": "packages/player/dist/timecat-player.js",
        "gzip": true,
        "limit": "50 kB"
    },
    {
        "name": "@timecat-js/player/export (the standalone script loaded on demand, included)",
        "path": "packages/player/dist/export.js",
        "import": "{ exportHtml }",
        "ignore": ["@timecat-js/protocol"],
        "gzip": true,
        "limit": "51 kB"
    }
]
